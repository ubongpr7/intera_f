# Runtime-only KA2A config for the frontend backend stack.
# Copy to ka2a.env and fill with the same local/dev values used by the backend stack.

DATABASE_URL=postgresql://user:password@host:5432/database
KA2A_DATABASE_URL=postgresql://user:password@host:5432/database
KA2A_JWT_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
KA2A_FERNET_KEY=replace-me
KA2A_FERNET_KEYS=replace-me
KA2A_SECRET_DECRYPTOR=kafka_a2a.secrets:decrypt_fernet_secret
SUBSCRIPTION_SERVICE_KEY=replace-me
